# vengine secrets — copy to `.env` (gitignored) and fill in.
# Only the server reads these; keys are NEVER sent to the browser.

# Primary: fal.ai aggregator — unlocks Nano Banana Pro, Seedream, Qwen, Z-Image, Flux.2
FAL_KEY=

# Optional providers (the matching fal/replicate/higgsfield models light up when set)
# REPLICATE_KEY=
# HIGGSFIELD_KEY=

# AI text assist (enrich / fix-grammar / shorten prompts & prose) — DeepSeek.
# When set, the sparkle "AI" buttons appear on every text field; when empty they hide.
DEEPSEEK_KEY=

# Optional: Claude intelligence layer (prompt-craft node / MCP), added in M5
# ANTHROPIC_API_KEY=

# Server port (default 5174)
# PORT=5174

# ── Remote source of truth ────────────────────────────────────────────────────
# The deployed worker (D1+R2) is the single store both the site and local dev share
# (the vite dev proxy targets this URL — override per-machine with VITE_API_TARGET
# in the repo root env to work fully offline against the local server).
# SYNC_REMOTE_URL=https://vengine.rome.markets

# The deployed ADMIN_PASSWORD — used by `pnpm --filter @vengine/server migrate:remote`,
# `seed:batman` and `story <file>` to log in and push/mutate data on the remote.
# SYNC_REMOTE_PASSWORD=

# Where `pnpm dev` (web) proxies /api + /ws. Defaults to https://vengine.rome.markets;
# set to http://localhost:5174 to use the local server's own ~/.vengine data instead.
# VITE_API_TARGET=https://vengine.rome.markets
